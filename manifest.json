{
  "manifest_version": 3,
  "name": "FFCamp AI",
  "version": "1.6.3",
  "description": "AI side panel: summarize pages into Markdown study notes saved to GitHub, and solve MCQs via OpenRouter.",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open FFCamp AI panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}